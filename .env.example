# General
APP_ENV=development
APP_NAME=OpsCentreDan
LOG_LEVEL=INFO
DEMO_MODE=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080
JWT_ISSUER=opscentredan-api
JWT_AUDIENCE=opscentredan-web
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
ADMIN_EMAIL=admin@opscentredan.dev
ADMIN_PASSWORD=ChangeMeNow123!

# Database
POSTGRES_DB=opscentredan
POSTGRES_USER=opscentredan
POSTGRES_PASSWORD=opscentredan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opscentredan:opscentredan@postgres:5432/opscentredan

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_chunks

# Storage
FILE_STORAGE_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=10

# AI Providers (optional)
LLM_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
